# Copie para `.env` (que o git ignora) e preencha. O servidor lê este arquivo sozinho:
# `npm run server` já usa --env-file-if-exists=.env.

# --- Onde o servidor responde -------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
# Endereço PÚBLICO do servidor: é o que vai dentro dos links enviados por e-mail.
APP_URL=http://localhost:4000
# Endereço do jogo, para o botão "voltar para o jogo" nas páginas de confirmação.
GAME_URL=http://localhost:4000

# --- Banco --------------------------------------------------------------------------------
GR_DB=data/guardioes.sqlite

# --- E-mail ------------------------------------------------------------------------------
# SEM SMTP_HOST, o servidor grava as mensagens em data/mail/ e mostra o link no terminal:
# dá para desenvolver e testar tudo sem provedor nenhum. Com SMTP_HOST, ele manda de verdade.
# Gmail: use uma "senha de app", não a senha da conta.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=voce@gmail.com
#SMTP_PASS=a-senha-de-app
#MAIL_FROM=Guardiões do Recife <voce@gmail.com>
